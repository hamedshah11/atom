# Required - Add via Streamlit secrets if deploying
OPENAI_API_KEY=

# Model Configuration - Use GPT-4o (More Reliable)
# GPT-4o: Fast, reliable, works with all agent types
# O3-mini: Can be used but may have intermittent issues
MODEL_ALL=gpt-4o

# Verbosity
VERBOSITY=low

# Serper Search API
USE_SERPER=1
SERPER_API_KEY=e62e1e8919e57b754e3acd05b2d2bb570effb93e

# Rate limiting (seconds) - INCREASED for reliability
# Higher value = fewer rate limit errors
RATE_LIMIT_DELAY=2.5

# Maximum retries for failed API calls
MAX_RETRIES=2
RETRY_DELAY=3.0

# LangSmith Configuration (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=business-idea-analyzer-gpt4o

# Debug mode - Set to 1 to see detailed logs
DEBUG_MODE=0
