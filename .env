# Required
OPENAI_API_KEY=

# Model Configuration (October 2025)
# Available models: gpt-4o-mini, gpt-4o, o1, o3-mini
# Note: o1 and o3-mini require API Tier 1+ ($5+ spend)
MODEL_ALL=gpt-4o-mini

# Verbosity
VERBOSITY=low

# Serper Search API
USE_SERPER=1
SERPER_API_KEY=e62e1e8919e57b754e3acd05b2d2bb570effb93e

# Rate limiting (seconds)
RATE_LIMIT_DELAY=1.0

# LangSmith Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=business-idea-analyzer

# Debug mode
DEBUG_MODE=0
