# Required
OPENAI_API_KEY=

# Model Configuration - O3-mini Only (October 2025)
# O3-mini: Best reasoning model with LangChain compatibility
# Fallback: gpt-4o (if O3-mini unavailable due to tier restrictions)
# Note: O4-mini doesn't exist yet
MODEL_ALL=o3-mini

# Verbosity
VERBOSITY=low

# Serper Search API
USE_SERPER=1
SERPER_API_KEY=e62e1e8919e57b754e3acd05b2d2bb570effb93e

# Rate limiting (seconds)
# O3-mini: 1.0-1.5 seconds recommended
RATE_LIMIT_DELAY=1.2

# LangSmith Configuration (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=business-idea-analyzer-o3mini

# Debug mode
DEBUG_MODE=0
