# Copy this file to .env and fill in your values

# Required

# Model Configuration - UPDATED FOR 2025
# Recommended: gpt-4o-mini (best value) or gpt-4o (best quality)
MODEL_ALL=gpt-4o

# Verbosity
VERBOSITY=low

# Optional - Serper Search API (for better market research)
USE_SERPER=1
SERPER_API_KEY=e62e1e8919e57b754e3acd05b2d2bb570effb93e

# Rate limiting delay (seconds)
# gpt-4o-mini and gpt-4o are faster, so we can reduce this
RATE_LIMIT_DELAY=1.0

# LangSmith Configuration (for observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=business-idea-analyzer

# Debug mode
DEBUG_MODE=0
