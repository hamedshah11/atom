# Copy this file to .env and fill in your values

# Required
OPENAI_API_KEY= 
MODEL_ALL=gpt-4-turbo  # Options: gpt-4-turbo, gpt-4, gpt-3.5-turbo
VERBOSITY=low          # Options: low, medium, high

# Optional - Serper Search API (for better market research)
USE_SERPER=0           # Set to 1 to enable
SERPER_API_KEY=e62e1e8919e57b754e3acd05b2d2bb570effb93e

# Optional - Rate limiting delay (seconds)
# Adjust based on your OpenAI tier
RATE_LIMIT_DELAY=1.5
